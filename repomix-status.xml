                  <th className="text-right py-2 px-3 font-semibold text-surface-800 dark:text-surface-100">Actions</th>
                </tr>
              </thead>
              <tbody>
                {reports.map((r) => (
                  <tr key={r.id} className="border-b border-surface-100 dark:border-dark-border last:border-0">
